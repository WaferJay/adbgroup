[Unit]
Description=Grouped ADB gateway and device lock service
After=network.target

[Service]
Type=simple
User=adbgroup
Group=adbgroup
SupplementaryGroups=plugdev
Environment=HOME=/var/lib/adbgroup
ExecStart=/usr/local/bin/adbgroup serve -config /etc/adbgroup/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
StateDirectory=adbgroup
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
